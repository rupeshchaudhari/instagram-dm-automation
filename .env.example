# Instagram DM Automation — Environment Variables
# Copy this file to .env and fill in your values.

# ============================================
# PostgreSQL
# ============================================
POSTGRES_USER=igdm_admin
POSTGRES_PASSWORD=changeme_pg_password
POSTGRES_DB=igdm_automation
POSTGRES_PORT=5432

# ============================================
# RabbitMQ
# ============================================
RABBITMQ_DEFAULT_USER=igdm_rabbit
RABBITMQ_DEFAULT_PASS=changeme_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ============================================
# Meta / Instagram API
# ============================================
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_custom_verify_token_here
META_APP_ID=your_meta_app_id_here

# ============================================
# Webhook Receiver (Node.js)
# ============================================
WEBHOOK_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# Worker Service (Spring Boot)
# ============================================
WORKER_PORT=8080
JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# General
# ============================================
TZ=UTC
